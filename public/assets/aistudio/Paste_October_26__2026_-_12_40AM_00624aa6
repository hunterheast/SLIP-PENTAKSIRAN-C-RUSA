                container.innerHTML = `<div class="bg-white p-8 rounded-2xl text-center text-slate-500 shadow-sm">Tiada rekod slip keputusan untuk dipaparkan.</div>`;
                return;
            }

            container.innerHTML = filtered.map((s, index) => {
                const defaultLogo = "https://placehold.co/100x100/6366f1/ffffff?text=LOGO";
                const logoSrc = schoolLogoDataUrl || defaultLogo;

                const schoolLines = escapeHtml(schoolName).split('\n');

                return `
                <div class="slip-card bg-white p-8 sm:p-12 rounded-none shadow-sm border border-slate-300 font-sans text-black ${index < filtered.length - 1 ? 'page-break' : ''}">
                    
                    <!-- Exact Header Layout from Reference Image -->
                    <div class="text-center flex flex-col items-center justify-center mb-2">
                        <img src="${logoSrc}" class="w-16 h-16 object-contain mb-2" alt="Logo Sekolah" onerror="this.src='${defaultLogo}'">
                        ${schoolLines.map(line => `<h2 class="text-sm sm:text-base font-bold uppercase tracking-wide leading-tight text-black">${line}</h2>`).join('')}
                    </div>

                    <!-- Framed Exam Title Box -->
                    <div class="w-full border-2 border-black py-1 px-3 text-center mb-6">
                        <h3 class="text-sm font-bold uppercase tracking-wide text-black">${escapeHtml(examTitle)}</h3>
                    </div>

                    <!-- Student Details Grid Matching Screenshot Layout -->
                    <div class="grid grid-cols-2 gap-x-8 gap-y-1 text-xs sm:text-sm mb-6 pb-2">
                        <div class="flex">
                            <span class="w-24 text-black font-semibold">Nama :</span>
                            <span class="font-bold text-black uppercase">${escapeHtml(s.name)}</span>
                        </div>
                        <div class="flex">
                            <span class="w-24 text-black font-semibold">Kelas :</span>
                            <span class="font-bold text-black uppercase">${escapeHtml(s.className)}</span>
                        </div>
                        <div class="flex">
                            <span class="w-24 text-black font-semibold">No K/P :</span>
                            <span class="text-black">${escapeHtml(s.mykid)}</span>
                        </div>
                        <div class="flex">
                            <span class="w-24 text-black font-semibold">Jantina :</span>
                            <span class="text-black uppercase">${escapeHtml(s.jantina)}</span>
                        </div>
                    </div>

                    <!-- Clean Minimal Table with Top and Bottom Heavy Lines -->
                    <div class="border-t-2 border-b-2 border-black py-1 mb-8">
                        <table class="w-full text-left text-xs sm:text-sm">
                            <thead>
                                <tr class="text-black font-bold border-b border-black">
                                    <th class="py-2 px-2 w-12 text-center">Bil</th>
                                    <th class="py-2 px-2">Mata Pelajaran</th>
                                    <th class="py-2 px-2 text-center w-28">Markah</th>
                                    <th class="py-2 px-2 text-center w-24">Gred</th>
                                </tr>
                            </thead>
                            <tbody class="text-black">
                                <tr class="border-b border-slate-100">
                                    <td class="py-2 px-2 text-center">1</td>
                                    <td class="py-2 px-2 font-medium">Bahasa Melayu</td>
                                    <td class="py-2 px-2 text-center font-bold">${s.bm}</td>
                                    <td class="py-2 px-2 text-center font-bold">
                                        <input type="text" class="no-print w-10 text-center border border-slate-300 rounded uppercase font-bold text-indigo-700" value="${s.bmGrade}" onchange="updateStudentGradeOverride(${s.id}, 'bm', this.value)">
                                        <span class="hidden print:inline">${s.bmGrade}</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-100">
                                    <td class="py-2 px-2 text-center">2</td>
                                    <td class="py-2 px-2 font-medium">Bahasa Inggeris</td>
                                    <td class="py-2 px-2 text-center font-bold">${s.bi}</td>
                                    <td class="py-2 px-2 text-center font-bold">
                                        <input type="text" class="no-print w-10 text-center border border-slate-300 rounded uppercase font-bold text-indigo-700" value="${s.biGrade}" onchange="updateStudentGradeOverride(${s.id}, 'bi', this.value)">
                                        <span class="hidden print:inline">${s.biGrade}</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-100">
                                    <td class="py-2 px-2 text-center">3</td>
                                    <td class="py-2 px-2 font-medium">Matematik</td>
                                    <td class="py-2 px-2 text-center font-bold">${s.mt}</td>
                                    <td class="py-2 px-2 text-center font-bold">
                                        <input type="text" class="no-print w-10 text-center border border-slate-300 rounded uppercase font-bold text-indigo-700" value="${s.mtGrade}" onchange="updateStudentGradeOverride(${s.id}, 'mt', this.value)">
                                        <span class="hidden print:inline">${s.mtGrade}</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-100">
                                    <td class="py-2 px-2 text-center">4</td>
                                    <td class="py-2 px-2 font-medium">Sains</td>
                                    <td class="py-2 px-2 text-center font-bold">${s.sn}</td>
                                    <td class="py-2 px-2 text-center font-bold">
                                        <input type="text" class="no-print w-10 text-center border border-slate-300 rounded uppercase font-bold text-indigo-700" value="${s.snGrade}" onchange="updateStudentGradeOverride(${s.id}, 'sn', this.value)">
                                        <span class="hidden print:inline">${s.snGrade}</span>
                                    </td>
                                </tr>
                                <tr class="border-b border-slate-100">
                                    <td class="py-2 px-2 text-center">5</td>
                                    <td class="py-2 px-2 font-medium">Sejarah</td>
                                    <td class="py-2 px-2 text-center font-bold">${s.sej}</td>
                                    <td class="py-2 px-2 text-center font-bold">
                                        <input type="text" class="no-print w-10 text-center border border-slate-300 rounded uppercase font-bold text-indigo-700" value="${s.sejGrade}" onchange="updateStudentGradeOverride(${s.id}, 'sej', this.value)">
                                        <span class="hidden print:inline">${s.sejGrade}</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Bottom Statistical Summary Matching Screenshot Layout -->
                    <div class="border-t-2 border-b-2 border-black py-4 mb-6">
                        <div class="grid grid-cols-2 gap-x-12 gap-y-1.5 text-xs sm:text-sm text-black">
                            <!-- Left Column -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between">
                                    <span>Bilangan matapelajaran</span>
                                    <span>: ${s.subjectCount}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Kedudukan dalam kelas</span>
                                    <span>: ${s.classRank}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Kedudukan keseluruhan</span>
                                    <span>: ${s.overallRank}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Pencapaian gred keseluruhan</span>
                                    <span>: ${s.gredSummary}</span>
                                </div>
                            </div>

                            <!-- Right Column -->
                            <div class="space-y-1.5">
                                <div class="flex justify-between">
                                    <span>Jumlah markah</span>
                                    <span>: ${s.total}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Peratus</span>
                                    <span>: ${s.avg}</span>
                                </div>
                                <div class="flex justify-between">
                                    <span>Gred purata</span>
                                    <span>: ${s.gpc}</span>
                                </div>
                                <div class="flex justify-between font-bold">
                                    <span>Keputusan</span>
                                    <span>: ${s.resultStatus}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Teacher Class Name & Remarks Matching Image -->
                    <div class="space-y-3 text-xs sm:text-sm text-black mb-8">
                        <div class="flex">
                            <span class="w-36 font-semibold">Nama guru kelas</span>
                            <span>: ${escapeHtml(s.teacherName)}</span>
                        </div>
                        <div class="flex items-start">
                            <span class="w-36 font-semibold">Ulasan</span>
                            <span>: ${escapeHtml(s.notes)}</span>
                        </div>
                    </div>

                    <!-- Signature Block -->
                    <div class="grid grid-cols-3 gap-4 text-center pt-8 text-xs text-black">
                        <div class="flex flex-col justify-between items-center h-24">
                            <span>Tandatangan Ibu Bapa / Penjaga</span>
                            <div class="w-36 border-b border-dashed border-black"></div>
                    <!-- Signature Block (Guru Besar Removed as requested) -->
                    <div class="grid grid-cols-2 gap-8 text-center pt-8 text-xs text-black">
                        <div class="flex flex-col justify-between items-center h-24">
                            <span>Tandatangan Ibu Bapa / Penjaga</span>
                            <div class="w-48 border-b border-dashed border-black"></div>
                            <span class="text-[10px]">( Tarikh: &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; )</span>
                        </div>
                        <div class="flex flex-col justify-between items-center h-24">
                            <span>Tandatangan Guru Kelas</span>
                            <div class="w-48 border-b border-dashed border-black"></div>
                            <span class="text-[10px]">( Nama & Cop )</span>
                        </div>
                    </div>

                </div>
                `;
            }).join('');
        }

        // Print Action
        function printSlips() {
            window.print();
        }

        // Render Analysis View
        function renderAnalysis() {
            if (parsedStudents.length === 0) processData();

            renderClassAnalysis();
            renderSubjectAnalysis();
        }

        // Class Analysis Logic
        function renderClassAnalysis() {
            const containerCards = document.getElementById('class-summary-cards');
            const classFilter = document.getElementById('analysis-class-filter');
            const tableBody = document.getElementById('analysis-class-table-body');

            const classes = [...new Set(parsedStudents.map(s => s.className))];

            if (classFilter.options.length === 0) {
                classFilter.innerHTML = `<option value="ALL">Semua Kelas</option>` + 
                    classes.map(c => `<option value="${c}">Kelas: ${c}</option>`).join('');
            }

            containerCards.innerHTML = classes.map(cName => {
                const cStudents = parsedStudents.filter(s => s.className === cName);
                const avgClass = (cStudents.reduce((acc, s) => acc + s.avg, 0) / cStudents.length).toFixed(1);
                const passCount = cStudents.filter(s => s.isPass).length;
                const passPercent = ((passCount / cStudents.length) * 100).toFixed(1);

                return `
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div class="flex justify-between items-start mb-2">
                        <h4 class="font-bold text-slate-800 text-base">${escapeHtml(cName)}</h4>
                        <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 text-xs font-bold rounded-md">${cStudents.length} Murid</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-2">
                        <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <span class="text-[10px] text-slate-400 font-semibold block uppercase">Purata Kelas</span>
                            <span class="text-lg font-black text-indigo-700">${avgClass}%</span>
                        </div>
                        <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                            <span class="text-[10px] text-slate-400 font-semibold block uppercase">% Peratus Lulus</span>
                            <span class="text-lg font-black text-emerald-600">${passPercent}%</span>
                        </div>
                    </div>
                </div>
                `;
            }).join('');

            const selectedClass = classFilter.value || 'ALL';
            let tableData = selectedClass === 'ALL' 
                ? [...parsedStudents] 
                : parsedStudents.filter(s => s.className === selectedClass);

            tableData.sort((a, b) => b.avg - a.avg);

            tableBody.innerHTML = tableData.map((s, idx) => {
                return `
                <tr class="border-b border-slate-100 hover:bg-slate-50/80 transition">
                    <td class="p-3 text-center font-bold text-slate-500">${idx + 1}</td>
                    <td class="p-3 font-semibold text-slate-800 uppercase">${escapeHtml(s.name)}</td>
                    <td class="p-3 text-slate-600">${escapeHtml(s.className)}</td>
                    <td class="p-3 text-center font-medium">${s.bm} (${s.bmGrade})</td>
                    <td class="p-3 text-center font-medium">${s.bi} (${s.biGrade})</td>
                    <td class="p-3 text-center font-medium">${s.mt} (${s.mtGrade})</td>
                    <td class="p-3 text-center font-medium">${s.sn} (${s.snGrade})</td>
                    <td class="p-3 text-center font-medium">${s.sej} (${s.sejGrade})</td>
                    <td class="p-3 text-center font-bold text-slate-800">${s.total}</td>
                    <td class="p-3 text-center font-black text-indigo-700">${s.avg}%</td>
                    <td class="p-3 text-center">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${s.isPass ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'}">
                            ${s.resultStatus}
                        </span>
                    </td>
                </tr>
                `;
            }).join('');
        }

        // Subject Analysis Logic & Render
        function renderSubjectAnalysis() {
            const tableBody = document.getElementById('analysis-subject-table-body');
            const totalStudents = parsedStudents.length;

            if (totalStudents === 0) return;

            const subjectStats = SUBJECT_KEYS.map(key => {
                const grades = { A: 0, B: 0, C: 0, D: 0, E: 0 };
                let totalScore = 0;

                parsedStudents.forEach(s => {
                    const score = s[key];
                    totalScore += score;
                    const g = s[key + 'Grade'] || getGrade(score);
                    if (grades[g] !== undefined) grades[g]++;
                });

                const passCount = grades.A + grades.B + grades.C + grades.D;
                const passPercent = ((passCount / totalStudents) * 100).toFixed(1);
                const avgScore = (totalScore / totalStudents).toFixed(1);

                return {
                    key,
                    name: SUBJECT_NAMES[key],
                    totalStudents,
                    grades,
                    passCount,
                    passPercent,
                    avgScore
                };
            });

            tableBody.innerHTML = subjectStats.map(st => `
                <tr class="border-b border-slate-100 hover:bg-slate-50 transition">
                    <td class="p-3 font-bold text-slate-800">${st.name}</td>
                    <td class="p-3 text-center text-slate-600">${st.totalStudents}</td>
                    <td class="p-3 text-center font-semibold text-emerald-600">${st.grades.A}</td>
                    <td class="p-3 text-center font-semibold text-blue-600">${st.grades.B}</td>
                    <td class="p-3 text-center font-semibold text-amber-600">${st.grades.C}</td>
                    <td class="p-3 text-center font-semibold text-orange-600">${st.grades.D}</td>
                    <td class="p-3 text-center font-semibold text-red-600">${st.grades.E}</td>
                    <td class="p-3 text-center font-bold text-slate-700">${st.passCount}</td>
                    <td class="p-3 text-center font-bold text-emerald-600">${st.passPercent}%</td>
                    <td class="p-3 text-center font-black text-indigo-700">${st.avgScore}%</td>
                </tr>
            `).join('');

            window.latestSubjectStats = subjectStats;
        }

        // Render Visual Charts using Chart.js
        function renderSubjectCharts() {
            const stats = window.latestSubjectStats;
            if (!stats) return;

            if (gradeChartInstance) gradeChartInstance.destroy();
            if (avgChartInstance) avgChartInstance.destroy();

            const ctxGrade = document.getElementById('chart-grade-distribution').getContext('2d');
            gradeChartInstance = new Chart(ctxGrade, {
                type: 'bar',
                data: {
                    labels: stats.map(s => s.name),
                    datasets: [
                        { label: 'Gred A', data: stats.map(s => s.grades.A), backgroundColor: '#10b981' },
                        { label: 'Gred B', data: stats.map(s => s.grades.B), backgroundColor: '#3b82f6' },
                        { label: 'Gred C', data: stats.map(s => s.grades.C), backgroundColor: '#f59e0b' },
                        { label: 'Gred D', data: stats.map(s => s.grades.D), backgroundColor: '#f97316' },
                        { label: 'Gred E', data: stats.map(s => s.grades.E), backgroundColor: '#ef4444' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: {
                        x: { stacked: true },
                        y: { stacked: true, beginAtZero: true }
                    }
                }
            });

            const ctxAvg = document.getElementById('chart-subject-averages').getContext('2d');
            avgChartInstance = new Chart(ctxAvg, {
                type: 'bar',
                data: {
                    labels: stats.map(s => s.name),
                    datasets: [{
                        label: 'Purata Markah (%)',
                        data: stats.map(s => s.avgScore),
                        backgroundColor: '#6366f1',
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, max: 100 }
                    }
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }

        // Share Link Functionality
        function shareLink() {
            const currentUrl = window.location.href;
            const dummy = document.createElement("input");
            document.body.appendChild(dummy);
            dummy.value = currentUrl;
            dummy.select();
            document.execCommand("copy");
            document.body.removeChild(dummy);
            
            // Show custom alert message box
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-5 right-5 z-50 bg-emerald-700 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 transform translate-y-0';
            toast.innerHTML = `<i data-lucide="check-circle" class="w-5 h-5"></i> <span class="text-sm font-medium">Pautan web berjaya disalin ke papan keratan (clipboard)!</span>`;
            document.body.appendChild(toast);
            lucide.createIcons();
            
            setTimeout(() => {
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }
    </script>
</body>
</html>