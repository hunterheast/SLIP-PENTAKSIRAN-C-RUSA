        // Attach Google Sheets style Paste handler across cells
        function attachPasteListenerToCells() {
            const tbody = document.getElementById('spreadsheet-tbody');
            tbody.addEventListener('paste', function (e) {
                const target = e.target;
                if (!target.classList.contains('grid-cell')) return;

                e.preventDefault();
                const clipboardData = e.clipboardData || window.clipboardData;
                const pastedText = clipboardData.getData('text');

                if (!pastedText) return;

                const rows = pastedText.trim().split('\n').map(r => r.split('\t'));
                const currentRow = target.closest('tr');
                const startRowIdx = Array.from(tbody.children).indexOf(currentRow);
                const startColIdx = Array.from(currentRow.querySelectorAll('input')).indexOf(target);

                rows.forEach((rowValues, rOffset) => {
                    let targetRow = tbody.children[startRowIdx + rOffset];
                    if (!targetRow) {
                        addNewGridRow();
                        targetRow = tbody.lastElementChild;
                    }

                    const inputs = targetRow.querySelectorAll('input');
                    rowValues.forEach((val, cOffset) => {
                        const cellInput = inputs[startColIdx + cOffset];
                        if (cellInput) {
                            cellInput.value = val.trim();
                        }
                    });
                });
            });
        }

