        // Process Interactive Spreadsheet Table Input Data
        function processData() {
            const tbody = document.getElementById('spreadsheet-tbody');
            const rows = tbody.querySelectorAll('tr');
            const list = [];

            rows.forEach((tr, index) => {
                const inputs = tr.querySelectorAll('input');
                const name = inputs[0]?.value.trim();
                const className = inputs[1]?.value.trim();

                if (!name && !className) return;

                const student = {
                    id: index + 1,
                    name: name || 'NAMA MURID',
                    className: className || '3 BESTARI',
                    mykid: inputs[2]?.value.trim() || '-',
                    jantina: inputs[3]?.value.trim() || 'LELAKI',
                    bm: parseFloat(inputs[4]?.value) || 0,
                    bi: parseFloat(inputs[5]?.value) || 0,
                    mt: parseFloat(inputs[6]?.value) || 0,
                    sn: parseFloat(inputs[7]?.value) || 0,
                    sej: parseFloat(inputs[8]?.value) || 0,
                    teacherName: inputs[9]?.value.trim() || 'PN. NORAINI BINTI HASNAN',
                    notes: inputs[10]?.value.trim() || ''
                };

                // Individual Grades (support override)
                student.bmGrade = getGrade(student.bm);
                student.biGrade = getGrade(student.bi);
                student.mtGrade = getGrade(student.mt);
                student.snGrade = getGrade(student.sn);
                student.sejGrade = getGrade(student.sej);

                const studentGrades = [student.bmGrade, student.biGrade, student.mtGrade, student.snGrade, student.sejGrade];

                // Computations
                student.subjectCount = 5;
                student.total = student.bm + student.bi + student.mt + student.sn + student.sej;
                student.avg = parseFloat((student.total / 5).toFixed(1));
                student.gpc = getGPC(studentGrades);
                student.gredSummary = getOverallGradeSummary(studentGrades);
                student.isPass = !studentGrades.includes('E');
                student.resultStatus = student.isPass ? 'LULUS' : 'GAGAL';

                list.push(student);
            });

            // Ranks Calculation (Class & Overall)
            list.sort((a, b) => b.avg - a.avg);
            list.forEach((s, idx) => {
                s.overallRank = idx + 1;
                s.totalStudentsOverall = list.length;
            });

            const classGroups = {};
            list.forEach(s => {
                if (!classGroups[s.className]) classGroups[s.className] = [];
                classGroups[s.className].push(s);
            });

            Object.keys(classGroups).forEach(cName => {
                classGroups[cName].sort((a, b) => b.avg - a.avg);
                classGroups[cName].forEach((s, idx) => {
                    s.classRank = idx + 1;
                    s.classTotalCount = classGroups[cName].length;
                });
            });

            parsedStudents = list;
            updateStatus(parsedStudents.length);
        }

