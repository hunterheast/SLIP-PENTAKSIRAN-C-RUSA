<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Penjana Slip Keputusan & Analisis Pentaksiran Sekolah Rendah</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js for Visual Analysis -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- SheetJS for Excel Upload support -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
        }

        /* Print Specific Styling */
        @media print {
            .no-print {
                display: none !important;
            }
            body {
                background-color: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .print-container {
                width: 100% !important;
                max-width: none !important;
                margin: 0 !important;
                padding: 0 !important;
                box-shadow: none !important;
            }
            .page-break {
                page-break-after: always;
                break-after: page;
            }
            .slip-card {
                box-shadow: none !important;
                border: 1px solid #e2e8f0 !important;
                padding: 2.5rem !important;
                margin-bottom: 0 !important;
                min-height: 98vh;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
            }
        }

        /* Borderless minimal table rows */
        .table-minimal th, .table-minimal td {
            border: none !important;
            padding: 10px 14px;
        }
        .table-minimal tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }
        .table-minimal tbody tr {
            border-bottom: 1px solid #f1f5f9 !important;
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-indigo-700 text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-indigo-600 rounded-lg">
                    <i data-lucide="graduation-cap" class="w-6 h-6 text-white"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight">Penjana Slip Keputusan</h1>
                    <p class="text-xs text-indigo-200">Pentaksiran & Analisis Sekolah Rendah</p>
                </div>
            </div>
            
            <!-- Main Navigation Tabs -->
            <nav class="flex space-x-1 sm:space-x-2 bg-indigo-800/50 p-1 rounded-xl">
                <button id="nav-data-tab" onclick="switchMainTab('data')" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium rounded-lg transition-all bg-white text-indigo-900 shadow-sm flex items-center space-x-2">
                    <i data-lucide="database" class="w-4 h-4"></i>
                    <span>Input Data Pukal</span>
                </button>
                <button id="nav-slips-tab" onclick="switchMainTab('slips')" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium rounded-lg text-indigo-100 hover:bg-indigo-600 transition-all flex items-center space-x-2">
                    <i data-lucide="file-text" class="w-4 h-4"></i>
                    <span>Paparan Slip</span>
                </button>
                <button id="nav-analysis-tab" onclick="switchMainTab('analysis')" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium rounded-lg text-indigo-100 hover:bg-indigo-600 transition-all flex items-center space-x-2">
                    <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                    <span>Analisis Khas</span>
                </button>
                <button onclick="shareLink()" class="px-3 py-1.5 sm:px-4 sm:py-2 text-xs sm:text-sm font-medium rounded-lg bg-emerald-500 hover:bg-emerald-600 text-white transition-all flex items-center space-x-1.5 shadow-sm">
                    <i data-lucide="share-2" class="w-4 h-4"></i>
                    <span class="hidden md:inline">Salin Pautan</span>
                </button>
            </nav>
        </div>
    </header>

    <!-- App Content Wrapper -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ========================================== -->
        <!-- TAB 1: INPUT DATA PUKAL & TETAPAN          -->
        <!-- ========================================== -->
        <section id="tab-data" class="space-y-6">
            <!-- Header Settings Card & Logo Upload -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    <i data-lucide="settings" class="w-5 h-5 text-indigo-600"></i>
                    Tetapan Maklumat Sekolah & Ujian
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-center">
                    <!-- Logo Upload Section -->
                    <div class="flex flex-col items-center justify-center p-3 border-2 border-dashed border-slate-300 rounded-xl bg-slate-50 hover:bg-slate-100 transition relative">
                        <div id="logo-preview-container" class="w-16 h-16 mb-2 flex items-center justify-center bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
                            <i id="logo-placeholder-icon" data-lucide="image" class="w-8 h-8 text-slate-400"></i>
                            <img id="school-logo-img" class="w-full h-full object-contain hidden" alt="Logo Sekolah">
                        </div>
                        <div class="flex gap-2">
                            <label class="px-3 py-1 text-xs font-semibold bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg cursor-pointer transition flex items-center gap-1">
                                <i data-lucide="upload" class="w-3 h-3"></i>
                                Upload Logo
                                <input type="file" id="logo-file-input" accept="image/*" class="hidden" onchange="handleLogoUpload(event)">
                            </label>
                            <button id="remove-logo-btn" onclick="removeLogo()" class="hidden px-2 py-1 text-xs font-semibold bg-rose-50 text-rose-600 hover:bg-rose-100 rounded-lg transition">
                                Padam
                            </button>
                        </div>
                    </div>

                    <!-- School Name & Exam Title -->
                    <div class="md:col-span-2 space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nama & Alamat Sekolah</label>
                            <input type="text" id="cfg-school-name" value="SEKOLAH KEBANGSAAN SI-RUSA&#10;PERSIARAN PAHLAWAN, PORT DICKSON" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Tajuk Ujian / Pentaksiran</label>
                            <input type="text" id="cfg-exam-title" value="SLIP KEPUTUSAN PENTAKSIRAN TAHUN 3" class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
                        </div>
                    </div>
                </div>

                <!-- Grade Threshold Settings -->
                <div class="mt-6 pt-4 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-xs font-semibold text-slate-600 uppercase">Tetapan Skala Gred Boleh Disunting (Sila Bebas Menetapkan Julat Markah Minima)</label>
                        <span class="text-[11px] text-indigo-600 font-medium">*Masukkan markah minima (Minimum Score) bagi setiap gred</span>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
                        <div class="bg-indigo-50/50 p-3 rounded-xl border border-indigo-100 text-center shadow-xs">
                            <span class="font-bold text-indigo-700 text-sm block mb-1">Gred A</span>
                            <div class="flex items-center justify-center gap-1 text-xs">
                                <span class="text-slate-500 font-medium">Min:</span>
                                <input type="number" id="gred-a-min" value="80" min="0" max="100" class="w-16 text-center border border-indigo-300 rounded-md p-1 font-bold text-indigo-900 bg-white focus:ring-2 focus:ring-indigo-500 outline-none" onchange="processData()">
                            </div>
                        </div>
                        <div class="bg-blue-50/50 p-3 rounded-xl border border-blue-100 text-center shadow-xs">
                            <span class="font-bold text-blue-700 text-sm block mb-1">Gred B</span>
                            <div class="flex items-center justify-center gap-1 text-xs">
                                <span class="text-slate-500 font-medium">Min:</span>
                                <input type="number" id="gred-b-min" value="65" min="0" max="100" class="w-16 text-center border border-blue-300 rounded-md p-1 font-bold text-blue-900 bg-white focus:ring-2 focus:ring-blue-500 outline-none" onchange="processData()">
                            </div>
                        </div>
                        <div class="bg-amber-50/50 p-3 rounded-xl border border-amber-100 text-center shadow-xs">
                            <span class="font-bold text-amber-700 text-sm block mb-1">Gred C</span>
                            <div class="flex items-center justify-center gap-1 text-xs">
                                <span class="text-slate-500 font-medium">Min:</span>
                                <input type="number" id="gred-c-min" value="50" min="0" max="100" class="w-16 text-center border border-amber-300 rounded-md p-1 font-bold text-amber-900 bg-white focus:ring-2 focus:ring-amber-500 outline-none" onchange="processData()">
                            </div>
                        </div>
                        <div class="bg-orange-50/50 p-3 rounded-xl border border-orange-100 text-center shadow-xs">
                            <span class="font-bold text-orange-700 text-sm block mb-1">Gred D</span>
                            <div class="flex items-center justify-center gap-1 text-xs">
                                <span class="text-slate-500 font-medium">Min:</span>
                                <input type="number" id="gred-d-min" value="40" min="0" max="100" class="w-16 text-center border border-orange-300 rounded-md p-1 font-bold text-orange-900 bg-white focus:ring-2 focus:ring-orange-500 outline-none" onchange="processData()">
                            </div>
                        </div>
                        <div class="bg-rose-50/50 p-3 rounded-xl border border-rose-100 text-center shadow-xs">
                            <span class="font-bold text-rose-700 text-sm block mb-1">Gred E</span>
                            <div class="flex items-center justify-center gap-1 text-xs">
                                <span class="text-slate-500 font-medium">Min:</span>
                                <input type="number" id="gred-e-min" value="0" min="0" max="100" class="w-16 text-center border border-rose-300 rounded-md p-1 font-bold text-rose-900 bg-white focus:ring-2 focus:ring-rose-500 outline-none" onchange="processData()">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Spreadsheet Grid Input Section -->
            <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                    <div>
                        <h2 class="text-lg font-bold text-slate-800 flex items-center gap-2">
                            <i data-lucide="table" class="w-5 h-5 text-indigo-600"></i>
                            Spreadsheet Input (Boleh Edit Data & Gred)
                        </h2>
                        <p class="text-xs text-slate-500 mt-0.5">Tampal (Paste) terus mana-mana sel/lajur dari Excel / Google Sheets atau sunting terus di dalam petak di bawah.</p>
                    </div>

                    <div class="flex items-center gap-2 flex-wrap">
                        <button onclick="loadSampleData()" class="px-3 py-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition flex items-center gap-1.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            Muat Data Contoh
                        </button>
                        <label class="px-3 py-1.5 text-xs font-semibold bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-200 rounded-lg cursor-pointer transition flex items-center gap-1.5">
                            <i data-lucide="upload" class="w-3.5 h-3.5"></i>
                            Muat Naik Excel (.xlsx)
                            <input type="file" id="excel-file-input" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleFileUpload(event)">
                        </label>
                    </div>
                </div>

                <!-- Grid Table Toolbar Controls -->
                <div class="flex items-center justify-between gap-2 mb-3 bg-slate-50 p-2 rounded-xl border border-slate-200 text-xs">
                    <div class="flex items-center gap-2">
                        <button onclick="addNewGridRow()" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-100 font-semibold rounded-lg text-slate-700 flex items-center gap-1">
                            <i data-lucide="plus" class="w-3.5 h-3.5 text-emerald-600"></i> Tambah Baris
                        </button>
                        <button onclick="clearGridData()" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-rose-50 hover:text-rose-600 font-semibold rounded-lg text-slate-700 flex items-center gap-1">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5 text-rose-500"></i> Kosongkan Jadual
                        </button>
                    </div>
                    <span class="text-slate-500 text-[11px] hidden sm:inline">*Petua: Tekan <b>Ctrl + V</b> pada mana-mana sel untuk menampal berbilang baris/lajur.</span>
                </div>

                <!-- Interactive Spreadsheet Table Grid -->
                <div class="overflow-x-auto border border-slate-300 rounded-xl max-h-[460px] relative shadow-inner">
                    <table id="spreadsheet-table" class="w-full border-collapse text-xs bg-white min-w-[1100px]">
                        <thead class="bg-slate-100 text-slate-700 sticky top-0 z-10 shadow-sm font-semibold select-none">
                            <tr>
                                <th class="w-10 p-2 border border-slate-300 text-center bg-slate-200">#</th>
                                <th class="p-2 border border-slate-300 text-left min-w-[180px]">NAMA MURID</th>
                                <th class="p-2 border border-slate-300 text-left min-w-[100px]">KELAS</th>
                                <th class="p-2 border border-slate-300 text-left min-w-[110px]">NO. K/P</th>
                                <th class="p-2 border border-slate-300 text-center w-20">JANTINA</th>
                                <th class="p-2 border border-slate-300 text-center w-20">BM</th>
                                <th class="p-2 border border-slate-300 text-center w-20">BI</th>
                                <th class="p-2 border border-slate-300 text-center w-20">MT</th>
                                <th class="p-2 border border-slate-300 text-center w-20">SN</th>
                                <th class="p-2 border border-slate-300 text-center w-20">SEJ</th>
                                <th class="p-2 border border-slate-300 text-left min-w-[140px]">NAMA GURU KELAS</th>
                                <th class="p-2 border border-slate-300 text-left min-w-[180px]">ULASAN</th>
                                <th class="w-10 p-2 border border-slate-300 text-center bg-slate-200"></th>
                            </tr>
                        </thead>
                        <tbody id="spreadsheet-tbody" class="divide-y divide-slate-200">
                            <!-- Dynamic Spreadsheet Rows -->
                        </tbody>
                    </table>
                </div>

                <div class="mt-4 flex flex-col sm:flex-row justify-between items-center gap-3">
                    <span id="data-status" class="text-xs font-medium text-slate-500">Tiada data diimbas.</span>
                    <button onclick="processData()" class="w-full sm:w-auto px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg transition flex items-center justify-center gap-2">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                        Proses & Penjana Slip
                    </button>
                </div>
            </div>
        </section>

        <!-- ========================================== -->
        <!-- TAB 2: PAPARAN SLIP (SINGLE & BULK PRINT)  -->
        <!-- ========================================== -->
        <section id="tab-slips" class="hidden space-y-6">
            
            <!-- Controls Bar (No Print) -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200 no-print flex flex-col md:flex-row items-center justify-between gap-4">
                
                <!-- Class Tabs -->
                <div id="class-tabs-container" class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto pb-2 md:pb-0">
                    <!-- Dynamic Class Tabs will be populated here -->
                </div>

                <!-- Action Toolbar -->
                <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                    <!-- Student Selector -->
                    <select id="student-select" onchange="renderSelectedStudentSlip()" class="px-3 py-2 text-sm border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="all">-- Semua Murid (Semua Slip) --</option>
                    </select>

                    <button onclick="printSlips()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow transition flex items-center gap-2">
                        <i data-lucide="printer" class="w-4 h-4"></i>
                        Cetak Slip (PDF)
                    </button>
                </div>
            </div>

            <!-- Print Preview Notice -->
            <div class="no-print bg-indigo-50 border border-indigo-100 rounded-xl p-3 text-xs text-indigo-700 flex items-center justify-between">
                <span class="flex items-center gap-2">
                    <i data-lucide="eye" class="w-4 h-4"></i>
                    Mod Pratinjau Slip Cetakan (Saiz Format A4)
                </span>
                <span id="slip-count-badge" class="font-bold bg-indigo-200 text-indigo-900 px-2 py-0.5 rounded-md">0 Slip</span>
            </div>

            <!-- Slips Container (Container printed directly) -->
            <div id="slips-container" class="print-container space-y-8">
                <!-- Dynamic Slips Rendered Here -->
            </div>
        </section>

        <!-- ========================================== -->
        <!-- TAB 3: ANALISIS KHAS (KELAS & SUBJEK)      -->
        <!-- ========================================== -->
        <section id="tab-analysis" class="hidden space-y-6">
            
            <!-- Sub tabs for Analysis -->
            <div class="flex border-b border-slate-200 space-x-4 no-print">
                <button id="subtab-class-btn" onclick="switchAnalysisSubTab('class')" class="pb-3 text-sm font-bold text-indigo-600 border-b-2 border-indigo-600 flex items-center gap-2">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    Analisis Mengikut Kelas
                </button>
                <button id="subtab-subject-btn" onclick="switchAnalysisSubTab('subject')" class="pb-3 text-sm font-bold text-slate-500 hover:text-slate-700 border-b-2 border-transparent flex items-center gap-2">
                    <i data-lucide="book-open" class="w-4 h-4"></i>
                    Analisis Mengikut Subjek
                </button>
            </div>

            <!-- SUB-TAB 1: CLASS ANALYSIS -->
            <div id="analysis-class-view" class="space-y-6">
                <!-- Dynamic Class Summary Cards -->
                <div id="class-summary-cards" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <!-- Cards inserted via JS -->
                </div>

                <!-- Class Ranking & Breakdown Table -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-bold text-slate-800 text-base flex items-center gap-2">
                            <i data-lucide="trophy" class="w-5 h-5 text-amber-500"></i>
                            Kedudukan & Rumusan Murid Mengikut Kelas
                        </h3>
                        <select id="analysis-class-filter" onchange="renderClassAnalysis()" class="px-3 py-1.5 text-xs font-semibold border border-slate-300 rounded-lg outline-none">
                            <!-- Populated dynamically -->
                        </select>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-700 border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-600 uppercase font-semibold border-b border-slate-200">
                                    <th class="p-3 text-center">Ked.</th>
                                    <th class="p-3">Nama Murid</th>
                                    <th class="p-3">Kelas</th>
                                    <th class="p-3 text-center">BM</th>
                                    <th class="p-3 text-center">BI</th>
                                    <th class="p-3 text-center">MT</th>
                                    <th class="p-3 text-center">SN</th>
                                    <th class="p-3 text-center">SEJ</th>
                                    <th class="p-3 text-center">Jumlah Markah</th>
                                    <th class="p-3 text-center">Purata (%)</th>
                                    <th class="p-3 text-center">Keputusan</th>
                                </tr>
                            </thead>
                            <tbody id="analysis-class-table-body">
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- SUB-TAB 2: SUBJECT ANALYSIS -->
            <div id="analysis-subject-view" class="hidden space-y-6">
                
                <!-- Subject Charts Grid -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Grade Distribution Chart -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <h4 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                            <i data-lucide="pie-chart" class="w-4 h-4 text-indigo-600"></i>
                            Taburan Gred Mengikut Subjek
                        </h4>
                        <div class="h-64 relative">
                            <canvas id="chart-grade-distribution"></canvas>
                        </div>
                    </div>

                    <!-- Subject Average Chart -->
                    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                        <h4 class="text-sm font-bold text-slate-800 mb-4 flex items-center gap-2">
                            <i data-lucide="bar-chart-2" class="w-4 h-4 text-indigo-600"></i>
                            Purata Markah (%) Mengikut Subjek
                        </h4>
                        <div class="h-64 relative">
                            <canvas id="chart-subject-averages"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Subject Breakdown Table -->
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <h3 class="font-bold text-slate-800 text-base mb-4 flex items-center gap-2">
                        <i data-lucide="table" class="w-5 h-5 text-indigo-600"></i>
                        Jadual Analisis Pencapaian Subjek
                    </h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs text-slate-700 border-collapse">
                            <thead>
                                <tr class="bg-slate-100 text-slate-600 uppercase font-semibold border-b border-slate-200">
                                    <th class="p-3">Mata Pelajaran</th>
                                    <th class="p-3 text-center">Bil. Calon</th>
                                    <th class="p-3 text-center">A</th>
                                    <th class="p-3 text-center">B</th>
                                    <th class="p-3 text-center">C</th>
                                    <th class="p-3 text-center">D</th>
                                    <th class="p-3 text-center">E</th>
                                    <th class="p-3 text-center">Bil. Lulus</th>
                                    <th class="p-3 text-center">% Lulus</th>
                                    <th class="p-3 text-center">Purata Markah (%)</th>
                                </tr>
                            </thead>
                            <tbody id="analysis-subject-table-body">
                                <!-- Dynamic rows -->
