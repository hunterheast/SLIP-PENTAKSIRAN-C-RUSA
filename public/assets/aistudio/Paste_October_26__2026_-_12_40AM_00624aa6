        // Grade Calculator with Editable capability
        function getGrade(score) {
            if (typeof score === 'string' && ['A','B','C','D','E'].includes(score.trim().toUpperCase())) {
                return score.trim().toUpperCase();
            }
            const numScore = parseFloat(score);
            if (isNaN(numScore)) return '-';

            const aMin = parseFloat(document.getElementById('gred-a-min').value) ?? 80;
            const bMin = parseFloat(document.getElementById('gred-b-min').value) ?? 65;
            const cMin = parseFloat(document.getElementById('gred-c-min').value) ?? 50;
            const dMin = parseFloat(document.getElementById('gred-d-min').value) ?? 40;
            const eMin = parseFloat(document.getElementById('gred-e-min').value) ?? 0;

            if (numScore >= aMin) return 'A';
            if (numScore >= bMin) return 'B';
            if (numScore >= cMin) return 'C';
            if (numScore >= dMin) return 'D';
            if (numScore >= eMin) return 'E';
            return 'E';
        }

        // Calculate Grade Point Average (GPC: A=1, B=2, C=3, D=4, E=5)
        function getGPC(grades) {
            const map = { 'A': 1, 'B': 2, 'C': 3, 'D': 4, 'E': 5 };
            let totalPoints = 0;
            let count = 0;
            grades.forEach(g => {
                if (map[g]) {
                    totalPoints += map[g];
                    count++;
                }
            });
            return count > 0 ? (totalPoints / count).toFixed(2) : '0.00';
        }

        function getOverallGradeSummary(grades) {
            const counts = { A: 0, B: 0, C: 0, D: 0, E: 0 };
            grades.forEach(g => { if (counts[g] !== undefined) counts[g]++; });
            const res = [];
            ['A','B','C','D','E'].forEach(k => {
                if (counts[k] > 0) res.push(`${counts[k]}${k}`);
            });
            return res.join(' ') || '-';
        }

