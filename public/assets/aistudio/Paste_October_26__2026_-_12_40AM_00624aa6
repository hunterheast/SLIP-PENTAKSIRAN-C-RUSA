        // File Upload Handling
        function handleFileUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, {type: 'array'});
                const firstSheet = workbook.SheetNames[0];
                const worksheet = workbook.Sheets[firstSheet];
                const json = XLSX.utils.sheet_to_json(worksheet, {header: 1});

                const formattedGrid = [];
                json.forEach((row, idx) => {
                    if (idx === 0 && (isNaN(row[4]) || row[0]?.toString().toLowerCase().includes('nama'))) return;
                    if (row.length >= 6) {
                        formattedGrid.push([
                            row[0] || '',
                            row[1] || '',
                            row[2] || '',
                            row[3] || 'LELAKI',
                            parseFloat(row[4]) || 0,
                            parseFloat(row[5]) || 0,
                            parseFloat(row[6]) || 0,
                            parseFloat(row[7]) || 0,
                            parseFloat(row[8]) || 0,
                            row[9] || 'PN. NORAINI BINTI HASNAN',
                            row[10] || ''
                        ]);
                    }
                });

                if (formattedGrid.length > 0) {
                    renderSpreadsheetGrid(formattedGrid);
                    processData();
                    alert('Data Excel berjaya dimuat naik dan dimasukkan ke dalam jadual!');
                } else {
                    alert('Format fail Excel tidak setara. Sila pastikan lajur mengikut susunan yang ditetapkan.');
                }
            };
            reader.readAsArrayBuffer(file);
        }

